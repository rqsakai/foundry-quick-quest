<div class="qq-sheet">

  <header class="qq-header">
    <input class="qq-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'QQ.Sheet.HeroName'}}" title="{{localize 'QQ.Tip.Name'}}"/>
    <div class="qq-idrow">
      <label title="{{localize 'QQ.Tip.Race'}}">{{localize "QQ.Sheet.Race"}}
        <select name="system.race">{{selectOptions raceChoices selected=system.race blank=(localize "QQ.Magic.Empty")}}</select>
      </label>
      <label title="{{localize 'QQ.Tip.Profession'}}">{{localize "QQ.Sheet.Profession"}}
        <select name="system.profession">{{selectOptions professionChoices selected=system.profession blank=(localize "QQ.Magic.Empty")}}</select>
      </label>
      <button type="button" class="qq-rebuild" data-action="openWizard" title="{{localize 'QQ.Tip.Rebuild'}}">{{localize "QQ.Sheet.Rebuild"}}</button>
    </div>
  </header>

  <section class="qq-stats">
    {{#each system.stats as |val key|}}
    <div class="qq-stat">
      <button type="button" class="qq-statbtn" data-action="rollCheck" data-stat="{{key}}"
              title="{{localize 'QQ.Sheet.CheckTip' stat=(localize (concat 'QQ.Stat.' key))}}">{{localize (concat "QQ.Stat." key)}}</button>
      <input type="number" name="system.stats.{{key}}" value="{{val}}" min="1" max="5" title="{{localize 'QQ.Tip.Stat'}}"/>
    </div>
    {{/each}}
  </section>

  <section class="qq-derived">
    <div class="qq-pool" title="{{localize 'QQ.Tip.Life'}}">
      <span class="qq-lbl">{{localize "QQ.Sheet.Life"}}</span>
      <input type="number" name="system.life.value" value="{{system.life.value}}"/>
      <span class="qq-max">/ {{system.life.max}}</span>
    </div>
    <div class="qq-pool" title="{{localize 'QQ.Tip.MP'}}">
      <span class="qq-lbl">{{localize "QQ.Sheet.Magic"}}</span>
      <input type="number" name="system.mp.value" value="{{system.mp.value}}"/>
      <span class="qq-max">/ {{system.mp.max}}</span>
    </div>
    <div class="qq-pool" title="{{localize 'QQ.Tip.Defense'}}">
      <span class="qq-lbl">{{localize "QQ.Sheet.Defense"}}</span>
      <span class="qq-defense">{{system.defense}}</span>
      <span class="qq-max" title="{{localize 'QQ.Tip.Armor'}}">{{localize "QQ.Sheet.Armor"}}
        <input type="number" name="system.armor" value="{{system.armor}}" min="0" max="4"/>
      </span>
    </div>
  </section>

  <section class="qq-toggles">
    <button type="button" class="qq-attack" data-action="rollAttack" title="{{localize 'QQ.Tip.Attack'}}">{{localize "QQ.Sheet.Attack"}}</button>
    <label class="qq-check" title="{{localize 'QQ.Tip.Raging'}}"><input type="checkbox" name="system.raging" {{checked system.raging}}/> {{localize "QQ.Sheet.Raging"}}</label>
    <label class="qq-check" title="{{localize 'QQ.Tip.Bonus'}}">{{localize "QQ.Sheet.BonusDmg"}} <input type="number" class="qq-bonus" name="system.bonus" value="{{system.bonus}}"/></label>
    <button type="button" class="qq-fumble" data-action="rollFumble" title="{{localize 'QQ.Tip.Fumble'}}">{{localize "QQ.Sheet.Fumble"}}</button>
  </section>

  <section class="qq-recover">
    <button type="button" data-action="treatWounds" title="{{localize 'QQ.Tip.Treat'}}">{{localize "QQ.Recover.Treat"}}</button>
    <label class="qq-check" title="{{localize 'QQ.Tip.Treated'}}"><input type="checkbox" name="system.treated" {{checked system.treated}}/> {{localize "QQ.Recover.Treated"}}</label>
    <button type="button" data-action="drinkPotion" title="{{localize 'QQ.Tip.Potion'}}">{{localize "QQ.Recover.Potion"}}</button>
  </section>

  <section class="qq-weapons">
    <div class="qq-wrow qq-whead">
      <span title="{{localize 'QQ.Tip.WeaponName'}}">{{localize "QQ.Weapon.Weapon"}}</span><span title="{{localize 'QQ.Tip.WeaponDie'}}">{{localize "QQ.Weapon.Die"}}</span><span title="{{localize 'QQ.Tip.WeaponStat'}}">{{localize "QQ.Weapon.Stat"}}</span><span title="{{localize 'QQ.Tip.WeaponType'}}">{{localize "QQ.Weapon.ColType"}}</span><span title="{{localize 'QQ.Tip.WeaponReach'}}">{{localize "QQ.Weapon.ColReach"}}</span><span></span><span></span>
    </div>
    {{#each weapons as |w|}}
    <div class="qq-wrow">
      <input type="text" name="system.weapons.{{w.key}}.name" value="{{w.name}}" placeholder="{{localize 'QQ.Weapon.EmptyName'}}" title="{{localize 'QQ.Tip.WeaponName'}}"/>
      <select name="system.weapons.{{w.key}}.die" title="{{localize 'QQ.Tip.WeaponDie'}}">
        <option value="d4" {{#if (eq w.die "d4")}}selected{{/if}}>d4</option>
        <option value="d6" {{#if (eq w.die "d6")}}selected{{/if}}>d6</option>
        <option value="d8" {{#if (eq w.die "d8")}}selected{{/if}}>d8</option>
      </select>
      <select name="system.weapons.{{w.key}}.stat" title="{{localize 'QQ.Tip.WeaponStat'}}">
        <option value="str" {{#if (eq w.stat "str")}}selected{{/if}}>{{localize "QQ.Stat.str"}}</option>
        <option value="agi" {{#if (eq w.stat "agi")}}selected{{/if}}>{{localize "QQ.Stat.agi"}}</option>
      </select>
      <select name="system.weapons.{{w.key}}.dtype" title="{{localize 'QQ.Tip.WeaponType'}}">
        <option value="bludgeoning" {{#if (eq w.dtype "bludgeoning")}}selected{{/if}}>{{localize "QQ.Weapon.Type.bludgeoning"}}</option>
        <option value="cutting" {{#if (eq w.dtype "cutting")}}selected{{/if}}>{{localize "QQ.Weapon.Type.cutting"}}</option>
        <option value="piercing" {{#if (eq w.dtype "piercing")}}selected{{/if}}>{{localize "QQ.Weapon.Type.piercing"}}</option>
      </select>
      <select name="system.weapons.{{w.key}}.reach" title="{{localize 'QQ.Tip.WeaponReach'}}">
        <option value="touching" {{#if (eq w.reach "touching")}}selected{{/if}}>{{localize "QQ.Weapon.Reach.touching"}}</option>
        <option value="thrown nearby" {{#if (eq w.reach "thrown nearby")}}selected{{/if}}>{{localize "QQ.Weapon.Reach.thrown nearby"}}</option>
        <option value="far" {{#if (eq w.reach "far")}}selected{{/if}}>{{localize "QQ.Weapon.Reach.far"}}</option>
      </select>
      <button type="button" data-action="weaponCard" data-weapon="{{w.key}}" title="{{localize 'QQ.Tip.WeaponCard'}}">📜</button>
      <button type="button" data-action="rollDamage" data-weapon="{{w.key}}" title="{{localize 'QQ.Tip.WeaponRoll'}}">🎲</button>
    </div>
    {{/each}}
  </section>

  <section class="qq-twocol">
    <div class="qq-box{{#if system.aceReady}} qq-ace-ready{{/if}}" title="{{#if system.aceReady}}{{localize 'QQ.Magic.AceReadyTip'}}{{else}}{{localize 'QQ.Tip.Ace'}}{{/if}}">
      <span class="qq-boxlbl">{{localize "QQ.Sheet.Ace"}}</span>
      {{#if system.professionData}}
      <div class="qq-ro qq-ro-strong" title="{{system.professionData.ace.effect}}">{{system.professionData.ace.name}}</div>
      <div class="qq-ro" title="{{system.professionData.ace.effect}}">{{localize "QQ.Sheet.PlaysWhen" trigger=system.professionData.ace.trigger}}</div>
      <button type="button" class="qq-ace-btn" data-action="playAce"
        {{#if system.ace.used}}disabled title="{{localize 'QQ.Ace.PlayedTip'}}"{{else}}title="{{system.professionData.ace.effect}}"{{/if}}>{{localize "QQ.Ace.Play"}}</button>
      {{else}}
      <div class="qq-ro qq-hint">{{localize "QQ.Sheet.PickProfession"}}</div>
      {{/if}}
      <label class="qq-check" title="{{localize 'QQ.Tip.AceUsed'}}"><input type="checkbox" name="system.ace.used" {{checked system.ace.used}}/> {{localize "QQ.Sheet.AceUsed"}}</label>
    </div>
    <div class="qq-box">
      <span class="qq-boxlbl">{{localize "QQ.Sheet.TraitMove"}}</span>
      <div class="qq-ro" title="{{localize 'QQ.Tip.Trait'}}">{{#if system.raceData}}{{system.raceData.trait}}{{else}}<span class="qq-hint">{{localize "QQ.Sheet.PickRace"}}</span>{{/if}}</div>
      <div class="qq-ro" title="{{localize 'QQ.Tip.Move'}}">{{#if system.professionData}}{{system.professionData.move}}{{else}}<span class="qq-hint">{{localize "QQ.Sheet.PickProfession"}}</span>{{/if}}</div>
    </div>
  </section>

  <section class="qq-twocol">
    <div class="qq-box qq-magic">
      <span class="qq-boxlbl">{{localize "QQ.Sheet.Spells"}}</span>
      {{#each slots as |slot|}}
      <div class="qq-slot">
        <span class="qq-lbl">{{slot.label}}</span>
        <select name="system.magic.{{slot.key}}" title="{{localize 'QQ.Tip.MP'}}">
          {{selectOptions slot.choices selected=slot.value blank=(localize "QQ.Magic.Empty")}}
        </select>
        {{#if slot.entry}}
        <button type="button" class="qq-cast" data-action="castSpell" data-slot="{{slot.key}}"
                title="{{localize 'QQ.Magic.CastTip'}}">{{localize "QQ.Magic.Cast"}}</button>
        {{else}}
        <span></span>
        {{/if}}
      </div>
      {{/each}}
      <label class="qq-check" title="{{localize 'QQ.Magic.ChanneledTip'}}">
        <input type="checkbox" name="system.magic.channeled" {{checked system.magic.channeled}}/>
        {{localize "QQ.Magic.Channeled"}}
      </label>
      {{#if magicPlaceholder}}<span class="qq-hint">{{localize "QQ.Magic.PlaceholderHint"}}</span>{{/if}}
    </div>
    <div class="qq-box">
      <span class="qq-boxlbl">{{localize "QQ.Sheet.Gear"}}</span>
      <textarea name="system.gear" rows="3" placeholder="{{localize 'QQ.Sheet.GearPlaceholder'}}" title="{{localize 'QQ.Tip.Gear'}}">{{system.gear}}</textarea>
      <div class="qq-coins">
        <label title="{{localize 'QQ.Tip.Gold'}}">{{localize "QQ.Sheet.Gold"}} <input type="number" name="system.gold" value="{{system.gold}}"/></label>
        <label title="{{localize 'QQ.Tip.Silver'}}">{{localize "QQ.Sheet.Silver"}} <input type="number" name="system.silver" value="{{system.silver}}"/></label>
      </div>
    </div>
  </section>

  <footer class="qq-remind">
    {{localize "QQ.Sheet.HeroFooter"}}
  </footer>

</div>
