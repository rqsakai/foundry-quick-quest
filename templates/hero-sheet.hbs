<div class="qq-sheet">

  <header class="qq-header">
    <input class="qq-name" name="name" type="text" value="{{actor.name}}" placeholder="Hero name"/>
    <div class="qq-idrow">
      <label>Race <input type="text" name="system.race" value="{{system.race}}"/></label>
      <label>Profession <input type="text" name="system.profession" value="{{system.profession}}"/></label>
    </div>
  </header>

  <section class="qq-stats">
    {{#each system.stats as |val key|}}
    <div class="qq-stat">
      <button type="button" class="qq-statbtn" data-action="rollCheck" data-stat="{{key}}"
              title="Roll a {{key}} check (advantage at 4+)">{{key}}</button>
      <input type="number" name="system.stats.{{key}}" value="{{val}}" min="1" max="5"/>
    </div>
    {{/each}}
  </section>

  <section class="qq-derived">
    <div class="qq-pool">
      <span class="qq-lbl">Life</span>
      <input type="number" name="system.life.value" value="{{system.life.value}}"/>
      <span class="qq-max">/ {{system.life.max}}</span>
    </div>
    <div class="qq-pool">
      <span class="qq-lbl">Magic</span>
      <input type="number" name="system.mp.value" value="{{system.mp.value}}"/>
      <span class="qq-max">/ {{system.mp.max}}</span>
    </div>
    <div class="qq-pool">
      <span class="qq-lbl">Defense</span>
      <span class="qq-defense">{{system.defense}}</span>
      <span class="qq-max">armor
        <input type="number" name="system.armor" value="{{system.armor}}" min="0" max="4"/>
      </span>
    </div>
  </section>

  <section class="qq-toggles">
    <button type="button" class="qq-attack" data-action="rollAttack">⚔ Attack d20</button>
    <label class="qq-check"><input type="checkbox" name="system.raging" {{checked system.raging}}/> Raging +2</label>
    <label class="qq-check">Bonus dmg <input type="number" class="qq-bonus" name="system.bonus" value="{{system.bonus}}"/></label>
    <button type="button" class="qq-fumble" data-action="rollFumble">Fumble d6</button>
  </section>

  <section class="qq-weapons">
    <div class="qq-wrow qq-whead">
      <span>Weapon</span><span>Die</span><span>Stat</span><span>Type</span><span>Reach</span><span></span>
    </div>
    {{#each weapons as |w|}}
    <div class="qq-wrow">
      <input type="text" name="system.weapons.{{w.key}}.name" value="{{w.name}}" placeholder="—"/>
      <select name="system.weapons.{{w.key}}.die">
        <option value="d4" {{#if (eq w.die "d4")}}selected{{/if}}>d4</option>
        <option value="d6" {{#if (eq w.die "d6")}}selected{{/if}}>d6</option>
        <option value="d8" {{#if (eq w.die "d8")}}selected{{/if}}>d8</option>
      </select>
      <select name="system.weapons.{{w.key}}.stat">
        <option value="str" {{#if (eq w.stat "str")}}selected{{/if}}>STR</option>
        <option value="agi" {{#if (eq w.stat "agi")}}selected{{/if}}>AGI</option>
      </select>
      <select name="system.weapons.{{w.key}}.dtype">
        <option value="bludgeoning" {{#if (eq w.dtype "bludgeoning")}}selected{{/if}}>Bludg.</option>
        <option value="cutting" {{#if (eq w.dtype "cutting")}}selected{{/if}}>Cutting</option>
        <option value="piercing" {{#if (eq w.dtype "piercing")}}selected{{/if}}>Piercing</option>
      </select>
      <select name="system.weapons.{{w.key}}.reach">
        <option value="touching" {{#if (eq w.reach "touching")}}selected{{/if}}>Touching</option>
        <option value="thrown nearby" {{#if (eq w.reach "thrown nearby")}}selected{{/if}}>Thrown</option>
        <option value="far" {{#if (eq w.reach "far")}}selected{{/if}}>Far</option>
      </select>
      <button type="button" data-action="rollDamage" data-weapon="{{w.key}}" title="Roll damage">🎲</button>
    </div>
    {{/each}}
  </section>

  <section class="qq-twocol">
    <div class="qq-box{{#if system.aceReady}} qq-ace-ready{{/if}}"{{#if system.aceReady}} title="{{localize 'QQ.Magic.AceReadyTip'}}"{{/if}}>
      <span class="qq-boxlbl">Ace — once per session</span>
      <input type="text" name="system.ace.name" value="{{system.ace.name}}" placeholder="Unbreakable, Final Word…"/>
      <label class="qq-check"><input type="checkbox" name="system.ace.used" {{checked system.ace.used}}/> Played this session</label>
    </div>
    <div class="qq-box">
      <span class="qq-boxlbl">Race trait &amp; profession move</span>
      <input type="text" name="system.trait" value="{{system.trait}}" placeholder="Trait"/>
      <input type="text" name="system.move" value="{{system.move}}" placeholder="Move"/>
    </div>
  </section>

  <section class="qq-twocol">
    <div class="qq-box qq-magic">
      <span class="qq-boxlbl">Spells &amp; cantrip</span>
      {{#each slots as |slot|}}
      <div class="qq-slot">
        <span class="qq-lbl">{{slot.label}}</span>
        <select name="system.magic.{{slot.key}}">
          {{selectOptions slot.choices selected=slot.value blank=(localize "QQ.Magic.Empty")}}
        </select>
        {{#if slot.entry}}
        <button type="button" class="qq-cast" data-action="castSpell" data-slot="{{slot.key}}"
                title="{{localize 'QQ.Magic.CastTip'}}">{{localize "QQ.Magic.Cast"}}</button>
        {{else}}
        <span></span>
        {{/if}}
      </div>
      {{/each}}
      <label class="qq-check" title="{{localize 'QQ.Magic.ChanneledTip'}}">
        <input type="checkbox" name="system.magic.channeled" {{checked system.magic.channeled}}/>
        {{localize "QQ.Magic.Channeled"}}
      </label>
      {{#if magicPlaceholder}}<span class="qq-hint">{{localize "QQ.Magic.PlaceholderHint"}}</span>{{/if}}
    </div>
    <div class="qq-box">
      <span class="qq-boxlbl">Gear &amp; coin</span>
      <textarea name="system.gear" rows="3" placeholder="Rope, torches…">{{system.gear}}</textarea>
      <div class="qq-coins">
        <label>Gold <input type="number" name="system.gold" value="{{system.gold}}"/></label>
        <label>Silver <input type="number" name="system.silver" value="{{system.silver}}"/></label>
      </div>
    </div>
  </section>

  <footer class="qq-remind">
    Hit: d20 ≥ Defense · nat 20 double · stat 4–5 = advantage on checks · channel: 2 Life per missing MP, once per fight
  </footer>

</div>
